class GradientLoss(nn.Module):
    def __init__(self):
        super(GradientLoss, self).__init__()
        self.loss_fn = nn.L1Loss()  # 使用 L1 损失计算梯度差异

    def gradient(self, img):
        """
        计算图像的梯度（x 和 y 方向）
        :param img: 输入图像，形状为 (N, C, H, W)
        :return: 图像的梯度，形状为 (N, C, H, W, 2)
        """
        # 计算 x 方向的梯度
        grad_x = img[:, :, :, 1:] - img[:, :, :, :-1]
        # 计算 y 方向的梯度
        grad_y = img[:, :, 1:, :] - img[:, :, :-1, :]
        # 填充边界以保持原始图像大小
        grad_x = F.pad(grad_x, (0, 1, 0, 0), mode='constant', value=0)
        grad_y = F.pad(grad_y, (0, 0, 0, 1), mode='constant', value=0)
        # 合并 x 和 y 方向的梯度
        gradient = torch.stack((grad_x, grad_y), dim=-1)
        return gradient

    def forward(self, pred, target):
        """
        计算梯度损失
        :param pred: 模型输出的恢复图像，形状为 (N, C, H, W)
        :param target: 真实图像（Ground Truth），形状为 (N, C, H, W)
        :return: 梯度损失值
        """
        # 计算恢复图像和真实图像的梯度
        grad_pred = self.gradient(pred)
        grad_target = self.gradient(target)
        # 计算梯度差异的 L1 损失
        loss = self.loss_fn(grad_pred, grad_target)
        return loss

class MSRB(nn.Module):
    def __init__(self, n_feats=64):
        super(MSRB, self).__init__()

        kernel_size_1 = 3
        kernel_size_2 = 5

        self.conv_3_1 = nn.Conv2d(n_feats, n_feats, kernel_size_1, padding=1)
        self.conv_3_2 = nn.Conv2d(n_feats * 2, n_feats * 2, kernel_size_1, padding=1)
        self.conv_5_1 = nn.Conv2d(n_feats, n_feats, kernel_size_2, padding=2)
        self.conv_5_2 = nn.Conv2d(n_feats * 2, n_feats * 2, kernel_size_2, padding=2)
        self.confusion = nn.Conv2d(n_feats * 4, n_feats*2, 1, padding=0, stride=1)
        self.relu = nn.ReLU(inplace=True)

    def forward(self, x):
        input_1 = x
        output_3_1 = self.relu(self.conv_3_1(input_1))
        output_5_1 = self.relu(self.conv_5_1(input_1))
        input_2 = torch.cat([output_3_1, output_5_1], 1)
        output_3_2 = self.relu(self.conv_3_2(input_2))
        output_5_2 = self.relu(self.conv_5_2(input_2))
        input_3 = torch.cat([output_3_2, output_5_2], 1)
        output = self.confusion(input_3)
        return output
